# URL da API do ValiStock
# Em desenvolvimento local, aponte para o backend rodando na máquina:
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Para dispositivo físico na mesma rede, use o IP da máquina:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api

# Em produção (Render), troque para a URL pública:
# EXPO_PUBLIC_API_URL=https://SEU-BACKEND.onrender.com/api
