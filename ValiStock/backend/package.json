{
  "name": "valistock-backend",
  "version": "1.0.0",
  "description": "Sistema de controle de validade e estoque - ValiStock",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "render-start": "npm run db:migrate && npm run db:seed && node server.js",
    "dev": "nodemon server.js",
    "pretest": "NODE_ENV=test DATABASE_PATH=./database/test.sqlite sequelize-cli db:migrate",
    "test": "NODE_ENV=test DATABASE_PATH=./database/test.sqlite node --test --test-concurrency=1 tests/",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "estoque",
    "validade",
    "supermercado",
    "sequeliz",
    "sqlite",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.5"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
