# Copie para .env e ajuste os valores. NUNCA versionar o .env real.
# Gere um JWT_SECRET forte com: openssl rand -base64 48

NODE_ENV=development
PORT=3000

# String de conexão do PostgreSQL (segredo: fica só no .env)
DATABASE_URL=postgres://goals:goals@localhost:5432/goal_tracker

# Banco DESCARTÁVEL dos testes de integração. OBRIGATÓRIA para `npm test`.
# Os testes rodam sync({ force: true }) e destroy({ force: true }): apontá-los
# para o banco de desenvolvimento apagaria o seed. Não há fallback.
# O docker compose já cria este banco na primeira subida do volume.
TEST_DATABASE_URL=postgres://goals:goals@localhost:5432/goal_tracker_test

# Segredo de assinatura dos tokens. Mínimo 32 caracteres.
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-bem-grande
JWT_EXPIRES_IN=1d

# Custo do hash de senha (bcrypt). 12 = bom equilíbrio segurança/performance.
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Origem permitida no CORS. Use "*" apenas em desenvolvimento.
CORS_ORIGIN=*

# SQL do Sequelize no console: true | false | sequelize | (sql) => void
SQL_LOGGING=false