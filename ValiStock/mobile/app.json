{
  "expo": {
    "name": "ValiStock",
    "slug": "valistock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valistock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O ValiStock usa a câmera para ler códigos de barras dos produtos."
      }
    },
    "android": {
      "package": "com.valistock.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O ValiStock usa a câmera para ler códigos de barras dos produtos.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f3e907f1-f573-45f1-b4cc-ad01b12bb135"
      }
    },
    "owner": "maximilianb1xs-team"
  }
}
