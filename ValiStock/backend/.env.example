# Ambiente
NODE_ENV=development

# Servidor
PORT=3000

# JWT
JWT_SECRET=altere-esta-chave-secreta-em-producao
JWT_EXPIRES_IN=24h

# Banco de dados
# Para SQLite (atualmente)
DATABASE_DIALECT=sqlite
DATABASE_PATH=./database/database.sqlite

# Para PostgreSQL (futuro) - descomentar quando migrar
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgresql://user:password@host:port/database
# DATABASE_SSL=true